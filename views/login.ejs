<%- include('partials/header') %>
<div class="login-container">
    <form action="/auth" method="POST">
        <h2>Login</h2>
<h2 style="background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 15px; border-radius: 5px; font-family: Arial, sans-serif; font-size: 18px; margin: 20px 0;">
  ⚠️ Due to inactivity since 2 days, it will close permanently.
</h2>
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
        <button type="submit" class="btn">Login</button>
    </form>


</div>

